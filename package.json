{
  "name": "collab-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "pnpm --filter @collab/server dev",
    "dev:client": "pnpm --filter @collab/client dev",
    "test": "pnpm --filter @collab/server test",
    "build": "pnpm -r build",
    "test:integration": "pnpm --filter @collab/server test:integration",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
