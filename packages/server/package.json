{
  "name": "@docsync/server",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs",
    "test": "vitest run",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5432/collab_test} TEST_REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "eval:assistant": "tsx eval/assistant-routing.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@docsync/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^5.79.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^5.1.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.99",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "undici": "^7.30.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.20",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12",
    "ioredis-mock": "^8.9.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "y-websocket": "^2.1.0"
  }
}
