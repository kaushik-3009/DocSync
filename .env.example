POSTGRES_USER=collab
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=collab
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
# Required by the server for secure startup. Use the exact browser origins
# that may call the API or open WebSockets; do not use a wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Local-only escape hatch for pre-auth development. It is rejected unless
# NODE_ENV=development and must never be used in Docker/AWS deployments.
# NODE_ENV=development
# ALLOW_INSECURE_LOCAL_AUTH_BYPASS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional product integrations. Keep real keys only in the ignored .env or
# your deployment secret manager; never commit them.
RESEND_API_KEY=
EMAIL_FROM=DocSync <docs@example.com>
APP_BASE_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sessions: short-lived access tokens, rotating refresh tokens.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# Object storage. Unset = store exports/images in Postgres (local dev only).
# EXPORTS_S3_BUCKET=
# UPLOADS_S3_BUCKET=

# Semantic search embeddings (needs pgvector). Without GEMINI_API_KEY a
# local hashing embedder is used.
# EMBEDDING_MODEL=gemini-embedding-001

# Webhooks: allow delivery to localhost/http for local testing only.
# Refused when NODE_ENV=production.
# WEBHOOKS_ALLOW_LOCAL=true
# WEBHOOK_DEBOUNCE_MS=3000
